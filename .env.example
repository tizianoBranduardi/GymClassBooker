# Copy to .env.deploy (git-ignored) and fill in. Anything left out is asked for
# interactively by `python scripts/manage.py deploy`.

# --- Gym booking API (you must bring your own values) ----------------------
GYM_API_KEY=
GYM_API_BASE_URL=https://api.example.com/v1
GYM_APP_ID=

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id. Leave empty to have the script detect it: it asks
# you to message the bot once.
ADMIN_USER_ID=

# --- Optional ---------------------------------------------------------------
# Bedrock model or inference profile reachable in your region.
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
DEFAULT_CLUB_ID=207
# Email for "booker crashed" alarms (you must confirm the SNS subscription mail).
ALARM_EMAIL=
